# Tables and functions for the store database. Imported by store.edg, so
# there's no need to run this config directly.
up {
  create_customer `CREATE TABLE IF NOT EXISTS customer (
      "id" UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      "email" STRING NOT NULL,

      UNIQUE("email")
    ) LOCALITY REGIONAL BY ROW`

  create_product `CREATE TABLE IF NOT EXISTS product (
      "id" UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      "name" STRING NOT NULL,

      UNIQUE("name")
    ) LOCALITY GLOBAL`

  create_market_product `CREATE TABLE IF NOT EXISTS market_product (
      "id" UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      "product_id" UUID NOT NULL REFERENCES product("id"),
      "market" STRING NOT NULL,
      "amount" DECIMAL NOT NULL,
      "currency" STRING NOT NULL,

      "crdb_region" crdb_internal_region AS (
        CASE
          WHEN "market" IN ('de', 'es', 'fr', 'ie', 'uk') THEN 'aws-eu-central-1'
          WHEN "market" IN ('br', 'bs', 'co', 'mx', 'us') THEN 'aws-us-east-1'
          WHEN "market" IN ('hk', 'in', 'ja', 'my', 'sg') THEN 'aws-ap-southeast-1'
          ELSE 'aws-eu-central-1'
        END
      ) STORED,

      INDEX ("market") STORING ("currency")
    ) LOCALITY REGIONAL BY ROW`

  create_stock `CREATE TABLE IF NOT EXISTS stock (
      "id" UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      "market_product_id" UUID NOT NULL,
      "quantity_on_hand" INT NOT NULL,
      "quantity_on_order" INT NOT NULL,

      FOREIGN KEY ("market_product_id", "crdb_region") REFERENCES market_product ("id", "crdb_region")
    ) LOCALITY REGIONAL BY ROW`

  create_basket `CREATE TABLE IF NOT EXISTS basket (
      "id" UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      "market_product_id" UUID NOT NULL,
      "customer_id" UUID NOT NULL,
      "quantity" INT NOT NULL,
      "ts" TIMESTAMPTZ NOT NULL DEFAULT now(),

      FOREIGN KEY ("market_product_id") REFERENCES market_product ("id"),
      FOREIGN KEY ("customer_id") REFERENCES customer ("id")
    ) WITH (
      ttl_expiration_expression = '((ts AT TIME ZONE ''UTC'') + INTERVAL ''10 minute'') AT TIME ZONE ''UTC''',
      ttl_job_cron = '* * * * *'
    ) LOCALITY REGIONAL BY ROW`

  create_purchase_status `CREATE TYPE IF NOT EXISTS purchase_status AS ENUM ('pending', 'paid', 'dispatched')`

  create_purchase `CREATE TABLE IF NOT EXISTS purchase (
      "id" UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      "customer_id" UUID NOT NULL,
      "market_product_ids" UUID[] NOT NULL,
      "amount" DECIMAL NOT NULL,
      "status" purchase_status NOT NULL DEFAULT 'pending',
      "ts" TIMESTAMPTZ NOT NULL DEFAULT now(),

      FOREIGN KEY ("customer_id", "crdb_region") REFERENCES customer ("id", "crdb_region")
    ) LOCALITY REGIONAL BY ROW`

  create_region_market `CREATE TABLE IF NOT EXISTS region_market (
      "region" STRING NOT NULL,
      "market" STRING NOT NULL,

      PRIMARY KEY ("region", "market")
    ) LOCALITY GLOBAL`

  create_add_to_basket `CREATE OR REPLACE FUNCTION add_to_basket(cust_id UUID, market_prod_id UUID, region crdb_internal_region, quant INT) RETURNS void AS $$
      DECLARE
        available INT;
      BEGIN
        -- If customer already has product in their basket, add to it, otherwise insert.
        INSERT INTO basket (customer_id, market_product_id, quantity, crdb_region)
          VALUES (cust_id, market_prod_id, quant, region);
      END;
    $$ LANGUAGE PLpgSQL`

  create_checkout `CREATE OR REPLACE FUNCTION checkout(cust_id UUID, region CRDB_INTERNAL_REGION) RETURNS UUID LANGUAGE PLpgSQL AS $$
      DECLARE
        products_out_of_stock UUID[];
        basket_products UUID[];
        basket_total DECIMAL;
        basket_item_count INT;
        purchase_id UUID;
      BEGIN
        -- Check customer has a basket with stuff in it.
        SELECT COUNT(*) INTO basket_item_count
        FROM basket
        WHERE customer_id = cust_id
        AND crdb_region = region;

        IF (basket_item_count < 1) THEN
          RAISE EXCEPTION 'Basket is empty';
        END IF;

        -- One last stock check of items in customer's basket.
        SELECT
          array_agg(s.market_product_id) AS market_product_id
        INTO products_out_of_stock
        FROM (
          SELECT
            b.market_product_id,
            b.crdb_region,
            SUM(b.quantity) AS quantity
          FROM basket b
          WHERE b.crdb_region = region
          AND b.customer_id = cust_id
          GROUP BY b.market_product_id, b.crdb_region
        ) AS b
        LEFT JOIN stock s ON s.market_product_id = b.market_product_id
          AND s.crdb_region = b.crdb_region
        WHERE s.quantity_on_hand - b.quantity < 0;

        IF (array_length(products_out_of_stock, 1) > 0) THEN
          RAISE EXCEPTION 'Products %s are out of stock', array_to_string(products_out_of_stock, ', ');
        END IF;

        -- Create purchase.
        SELECT array_agg(market_product_id) INTO basket_products
        FROM basket b
        WHERE b.customer_id = cust_id
        AND b.crdb_region = region;

        SELECT SUM(mp.amount * b.quantity) INTO basket_total
        FROM basket b
        JOIN market_product mp ON b.market_product_id = mp.id
          AND b.crdb_region = mp.crdb_region
        WHERE b.customer_id = cust_id
        AND b.crdb_region = region;

        INSERT INTO purchase ("customer_id", "market_product_ids", "amount", "crdb_region")
        VALUES (
          cust_id,
          basket_products,
          basket_total,
          region
        ) RETURNING id INTO purchase_id;

        -- Remove stock.
        UPDATE stock
        SET quantity_on_hand = quantity_on_hand - b.quantity
        FROM (
          SELECT quantity, market_product_id
          FROM basket
          WHERE customer_id = cust_id
          AND crdb_region = region
        ) AS b
        WHERE stock.market_product_id = b.market_product_id
        AND stock.crdb_region = region;

        -- Clear basket.
        DELETE FROM basket WHERE customer_id = cust_id AND crdb_region = region;

        RETURN purchase_id;
      END;
    $$`
}

down {
  drop_checkout `DROP FUNCTION IF EXISTS checkout`

  drop_add_to_basket `DROP FUNCTION IF EXISTS add_to_basket`

  drop_region_market `DROP TABLE IF EXISTS region_market`

  drop_purchase `DROP TABLE IF EXISTS purchase`

  drop_purchase_status `DROP TYPE IF EXISTS purchase_status`

  drop_basket `DROP TABLE IF EXISTS basket`

  drop_stock `DROP TABLE IF EXISTS stock`

  drop_market_product `DROP TABLE IF EXISTS market_product`

  drop_product `DROP TABLE IF EXISTS product`

  drop_customer `DROP TABLE IF EXISTS customer`
}
